# ============================================================================
# PowerCore Environment Variables
# Copy this file to .env.local and fill in your values
# ============================================================================

# ============================================================================
# Application
# ============================================================================
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=PowerCore

# ============================================================================
# API Configuration
# ============================================================================
NEXT_PUBLIC_API_URL=http://localhost:5003

# Backend API ports (if running locally)
# API_PORT_LEADERBOARD=5001
# API_PORT_RAG=5002
# API_PORT_MONETIZATION=5003

# ============================================================================
# Database
# ============================================================================
DATABASE_URL=postgresql://username:password@localhost:5432/powercore?schema=public

# Optional: Connection pooling for production
# DATABASE_POOL_URL=postgresql://username:password@pooler.example.com:5432/powercore

# ============================================================================
# Authentication
# ============================================================================

# NextAuth.js
NEXTAUTH_SECRET=your-nextauth-secret-generate-with-openssl-rand-base64-32
NEXTAUTH_URL=http://localhost:3000

# OAuth - GitHub
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# OAuth - Google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# OAuth - Discord (optional)
# DISCORD_CLIENT_ID=
# DISCORD_CLIENT_SECRET=

# ============================================================================
# Stripe (Payments)
# ============================================================================

# API Keys
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key

# Webhooks
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# Stripe Connect (for creator payouts)
STRIPE_CONNECT_CLIENT_ID=

# Price IDs for subscriptions
STRIPE_PRICE_ID_PRO_MONTHLY=price_xxx
STRIPE_PRICE_ID_PRO_YEARLY=price_xxx
STRIPE_PRICE_ID_ENTERPRISE_MONTHLY=price_xxx

# ============================================================================
# Crypto Payments (Optional)
# ============================================================================

# WalletConnect
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Ethereum RPC (for verifying transactions)
# ETH_RPC_URL=https://mainnet.infura.io/v3/your-project-id

# ============================================================================
# x402 Micropayments (Optional)
# ============================================================================
# X402_MACAROON_SECRET=
# X402_LND_REST_URL=
# X402_LND_MACAROON=

# ============================================================================
# Email
# ============================================================================

# Email provider: 'resend' | 'sendgrid' | 'postmark'
EMAIL_PROVIDER=resend

# Resend
RESEND_API_KEY=re_your_resend_api_key

# SendGrid (alternative)
# SENDGRID_API_KEY=

# Postmark (alternative)
# POSTMARK_API_TOKEN=

# Email addresses
FROM_EMAIL=PowerCore <noreply@powercore.app>
SUPPORT_EMAIL=support@powercore.app

# ============================================================================
# Analytics
# ============================================================================

# PostHog
NEXT_PUBLIC_POSTHOG_KEY=phc_your_posthog_key
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# Plausible (alternative - privacy-focused)
# NEXT_PUBLIC_PLAUSIBLE_DOMAIN=powercore.app

# Google Analytics (optional)
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# ============================================================================
# Error Tracking
# ============================================================================

# Sentry
SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx
SENTRY_AUTH_TOKEN=
SENTRY_ORG=your-org
SENTRY_PROJECT=powercore

# ============================================================================
# Search
# ============================================================================

# Meilisearch
MEILISEARCH_HOST=http://localhost:7700
MEILISEARCH_MASTER_KEY=your_master_key

# Algolia (alternative)
# NEXT_PUBLIC_ALGOLIA_APP_ID=
# NEXT_PUBLIC_ALGOLIA_SEARCH_KEY=
# ALGOLIA_ADMIN_KEY=

# ============================================================================
# Storage (for file uploads)
# ============================================================================

# AWS S3 / Cloudflare R2
# S3_BUCKET=powercore-uploads
# S3_REGION=us-east-1
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_ENDPOINT= # For R2 or other S3-compatible services

# ============================================================================
# Real-time (WebSockets)
# ============================================================================

# Pusher
# NEXT_PUBLIC_PUSHER_KEY=
# PUSHER_APP_ID=
# PUSHER_SECRET=
# PUSHER_CLUSTER=

# Ably (alternative)
# ABLY_API_KEY=

# ============================================================================
# CDN / Edge
# ============================================================================

# Cloudflare
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_API_TOKEN=

# ============================================================================
# Feature Flags
# ============================================================================
NEXT_PUBLIC_ENABLE_CRYPTO_PAYMENTS=false
NEXT_PUBLIC_ENABLE_X402=false
NEXT_PUBLIC_ENABLE_WEBSOCKETS=false
NEXT_PUBLIC_ENABLE_AI_PRICING=false

# Maintenance mode
# NEXT_PUBLIC_MAINTENANCE_MODE=false

# ============================================================================
# Rate Limiting
# ============================================================================

# Upstash Redis (for rate limiting)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ============================================================================
# CI/CD
# ============================================================================

# Vercel
VERCEL_TOKEN=
VERCEL_ORG_ID=
VERCEL_PROJECT_ID=

# ============================================================================
# Development Only
# ============================================================================

# Seed data
# SEED_ADMIN_EMAIL=admin@powercore.app
# SEED_ADMIN_PASSWORD=

# Debug mode
# DEBUG=true
